# Only live mode reads this file. Offline demo needs no environment variables.
PG_DSN=postgresql://warehouse:warehouse@127.0.0.1:5432/warehouse
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DORIS_HOST=127.0.0.1
DORIS_USER=root
DORIS_PASSWORD=
DORIS_DATABASE=warehouse
DS_BASE_URL=http://127.0.0.1:12345/dolphinscheduler
DS_API_KEY=
LLM_PROVIDER=custom
LLM_MODEL=your-model-name
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_API_KEY=
LLM_ALLOW_PROGRAMMATIC_FALLBACK=false
# Embedding enrichment is disabled unless this separate endpoint is configured.
LLM_EMBEDDING_API_BASE=
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=text-embedding-v3
# Generate your own 16-byte SM4 key (32 hexadecimal characters).
SM4_KEY=
SECRET_BACKEND=env
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
